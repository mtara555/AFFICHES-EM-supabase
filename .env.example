# ============================================================================
# AFFICHES-EM v1.0 — Variables d'environnement (Supabase)
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet
# (Supabase > Project Settings > API). `.env.local` n'est jamais versionne.
#
# Ces deux valeurs sont publiques par conception : elles figurent dans tout
# code client Supabase. La securite repose sur les regles RLS de la base
# (supabase/schema.sql), jamais sur leur confidentialite.
# ============================================================================

# URL du projet, ex. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Cle « anon » / « publishable » (jamais la cle service_role)
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# UNIQUEMENT pour le script de migration (npm run migrer:appwrite)
# ----------------------------------------------------------------------------
# Ces cles sont de VRAIS secrets. Elles n'ont volontairement pas de prefixe
# VITE_, ce qui garantit que Vite ne les inclura jamais dans le code compile.
# Supprimez-les de .env.local une fois la migration terminee, puis revoquez-les.
#
# SUPABASE_SERVICE_ROLE_KEY=
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_DATABASE_ID=affiches-em
# APPWRITE_API_KEY=   (droits : databases.read, files.read, users.read, teams.read)
